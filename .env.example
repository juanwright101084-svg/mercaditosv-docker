# Copia este archivo a ".env" y completa los valores. NUNCA subas ".env" a GitHub.

# ---------------- MySQL ----------------
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=mercaditosv
MYSQL_USER=mercadito
MYSQL_PASSWORD=cambia_esta_clave

# ---------------- Backend (Laravel) ----------------
# Genera la clave con (no necesitas PHP instalado):
#   docker run --rm php:8.4-cli-alpine php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
# URL pública de la API tal como la ve el navegador
APP_URL=http://localhost:8000

# ---------------- Stripe (claves de PRUEBA: https://dashboard.stripe.com/test/apikeys) ----------------
STRIPE_PUBLISHABLE_KEY=pk_test_tu_clave_publicable_aqui
STRIPE_SECRET=sk_test_tu_clave_secreta_aqui

# ---------------- Frontend (Next.js) ----------------
# URLs que usa el NAVEGADOR; se incrustan al construir la imagen (docker compose build)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_IMAGE_URL=http://localhost:8000
